<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CoopStory.Launcher</AssemblyName>
    <RootNamespace>CoopStory.Launcher</RootNamespace>
    <Version>11.4.0</Version>
    <InformationalVersion>11.4.0-password-lobby</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CoopStory.Protocol\CoopStory.Protocol.csproj" />
  </ItemGroup>
</Project>
